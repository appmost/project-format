{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.appmost.ai/format/schemas/2.0/app.schema.json",
  "title": "Appmost Project Format 2.0 metadata",
  "type": "object",
  "required": ["documentVersion", "name", "currentVersion", "versionNumbers"],
  "properties": {
    "documentVersion": { "const": 2 },
    "name": { "type": "string" },
    "currentVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "versionNumbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
    },
    "highestVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "additionalProperties": true,
  "$defs": {
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9._-]+$" }
    }
  }
}
