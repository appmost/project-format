{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.appmost.ai/format/schemas/2.0/version.schema.json",
  "title": "Appmost Project Format 2.0 stored version",
  "type": "object",
  "required": ["documentVersion", "version", "startPageId", "pageFileNames"],
  "properties": {
    "documentVersion": { "const": 2 },
    "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "releaseState": {
      "const": "locked",
      "$comment": "Unlocked is the default and is omitted."
    },
    "startPageId": { "type": "string", "minLength": 1 },
    "pageFileNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^./\\\\][^/\\\\]*\\.json$" }
    },
    "extensions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9._-]+$" }
    }
  },
  "additionalProperties": true
}
