{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.appmost.ai/format/schemas/2.11/version.schema.json",
  "title": "Appmost Project Format 2.1 stored version",
  "type": "object",
  "required": [
    "documentVersion",
    "version",
    "startPageId",
    "pageFileNames"
  ],
  "properties": {
    "documentVersion": {
      "const": 2
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "releaseState": {
      "const": "locked",
      "$comment": "Unlocked is the default and is omitted."
    },
    "startPageId": {
      "type": "string",
      "minLength": 1
    },
    "pageFileNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[^./\\\\][^/\\\\]*\\.json$"
      }
    },
    "globalTheme": {
      "type": "object",
      "properties": {
        "webAppearance": {
          "type": "string",
          "enum": [
            "standard",
            "glass",
            "brand",
            "material"
          ],
          "default": "standard",
          "description": "Visual treatment for adaptive web navigation. It does not change page-graph semantics or placement rules."
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9.-]+/[a-zA-Z0-9._-]+$"
      }
    },
    "disableSystemTextScaling": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "When true, Appmost's native iOS and Android renderers use the authored text scale without system text scaling. False, null, or omission preserves the platform's existing behavior."
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "revenueCatIntegrationModel": {
            "type": "object",
            "required": [
              "iosApiKey",
              "androidApiKey",
              "entitlementId"
            ],
            "properties": {
              "iosApiKey": {
                "type": "string",
                "description": "Public app-specific RevenueCat iOS SDK key; never a secret REST API key."
              },
              "androidApiKey": {
                "type": "string",
                "description": "Public app-specific RevenueCat Android SDK key; never a secret REST API key."
              },
              "entitlementId": {
                "type": "string"
              },
              "offeringId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Omission, null or an empty string selects the default offering."
              }
            },
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "revenueCat"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "revenueCatIntegrationModel"
              ]
            }
          }
        ],
        "additionalProperties": true
      },
      "contains": {
        "type": "object",
        "required": [
          "type",
          "active"
        ],
        "properties": {
          "type": {
            "const": "revenueCat"
          },
          "active": {
            "const": true
          }
        }
      },
      "minContains": 0,
      "maxContains": 1
    }
  },
  "additionalProperties": true,
  "not": {
    "required": [
      "testData"
    ]
  }
}
